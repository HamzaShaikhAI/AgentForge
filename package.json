{
  "name": "agentforge",
  "version": "0.1.0",
  "description": "Extensible capability harness for Google Antigravity",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agentforge": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "manager/index.html",
    "bridges",
    "rules",
    "skills",
    "plugin.json",
    "mcp_config.json",
    "publisher-client.example.json",
    "google-client.example.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "cli": "node dist/cli/index.js",
    "auth": "node dist/cli/index.js auth",
    "manager": "node dist/manager/serve.js",
    "demo": "node dist/demo.js",
    "mcp": "node dist/mcp-server.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HamzaShaikhAI/AgentForge.git"
  },
  "bugs": {
    "url": "https://github.com/HamzaShaikhAI/AgentForge/issues"
  },
  "homepage": "https://github.com/HamzaShaikhAI/AgentForge#readme",
  "keywords": ["antigravity", "plugin", "bridges", "automation"],
  "license": "MIT",
  "engines": { "node": ">=20" },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0"
  }
}
