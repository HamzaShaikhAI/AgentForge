# AgentForge Configuration Template
# Copy this file to .env for local development. Never commit real credentials to Git.

# Google OAuth Publisher / Built-in Client (Desktop App)
# AGENTFORGE_BUILTIN_CLIENT_ID="<PROJECT_NUMBER>-<HASH>.apps.googleusercontent.com"
# AGENTFORGE_BUILTIN_CLIENT_SECRET=""

# Developer Mode Google OAuth Override
# GOOGLE_CLIENT_ID="<PROJECT_NUMBER>-<HASH>.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET=""

# GitHub Integration (optional personal access token)
# GITHUB_TOKEN=""

# Custom Credentials Directory (defaults to OS user profile / AppData)
# AGENTFORGE_CREDENTIALS_DIR=""
